{
  "name": "fintrack",
  "version": "1.0.0",
  "description": "Transaction analytics and reporting platform - modular monolith API with background workers",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/worker"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "infra:up": "docker compose up -d postgres mongodb redis",
    "infra:down": "docker compose down",
    "seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
