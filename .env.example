# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
INSTANCE_ID=api-local
LOG_LEVEL=info

# Matches docker-compose.yml credentials
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=public
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=fintrack
REDIS_URL=redis://localhost:6379

# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Report period boundaries use this zone; all storage stays UTC (ADR-011)
REPORT_TIMEZONE=Asia/Kolkata
CACHE_TTL_SECONDS=600
