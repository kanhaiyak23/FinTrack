generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Postgres enums rather than free-text columns: the database rejects an unknown
// transaction type instead of trusting the application to have validated it.

enum AccountType {
  CHECKING
  SAVINGS
  BROKERAGE

  @@map("account_type")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("transaction_status")
}

enum PlanType {
  SIP
  LUMPSUM
  RECURRING

  @@map("plan_type")
}

enum PlanFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY

  @@map("plan_frequency")
}

enum PlanStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@map("plan_status")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED

  @@map("subscription_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts      Account[]
  plans         InvestmentPlan[]
  subscriptions Subscription[]

  @@map("users")
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  accountType AccountType @map("account_type")
  // Money is NUMERIC(20,4) everywhere. Never a float: 0.1 + 0.2 is not 0.3, and a
  // financial ledger cannot absorb that (CLAUDE.md invariant 1).
  balance     Decimal     @default(0) @db.Decimal(20, 4)
  currency    String      @default("INR") @db.Char(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  type   TransactionType
  // symbol/quantity/price are populated for BUY and SELL only. A CHECK constraint
  // in the migration enforces that pairing rather than leaving it to the service.
  symbol String?
  // 8 decimal places so fractional units are representable.
  quantity Decimal? @db.Decimal(20, 8)
  price    Decimal? @db.Decimal(20, 4)
  // Total cash moved. For a trade this is quantity * price.
  amount   Decimal  @db.Decimal(20, 4)

  transactionTime DateTime          @default(now()) @map("transaction_time") @db.Timestamptz(6)
  status          TransactionStatus @default(COMPLETED)

  // Scoped to the account, not global: two users must be free to pick the same
  // client-supplied key. NULL means the client did not ask for idempotency, and
  // Postgres treats NULLs as distinct, so unkeyed transactions never collide.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, idempotencyKey], map: "uq_transactions_account_idempotency")
  // History reads filter by account and order by time - the index serves both.
  @@index([accountId, transactionTime(sort: Desc)], map: "idx_transactions_account_time")
  @@index([accountId, type], map: "idx_transactions_account_type")
  // Portfolio aggregation groups by symbol within an account.
  @@index([accountId, symbol], map: "idx_transactions_account_symbol")
  @@map("transactions")
}

model InvestmentPlan {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  name      String
  planType  PlanType      @map("plan_type")
  amount    Decimal       @db.Decimal(20, 4)
  frequency PlanFrequency
  status    PlanStatus    @default(ACTIVE)
  startDate DateTime      @map("start_date") @db.Date
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId, status], map: "idx_plans_user_status")
  @@map("investment_plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime?          @map("ended_at") @db.Timestamptz(6)

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "idx_subscriptions_user_status")
  @@index([planId])
  @@map("subscriptions")
}

// Written inside the same transaction as the business change it describes, so an
// event can never be lost between a commit and a queue publish (ADR-005).
model OutboxEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  payload    Json     @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  // NULL until the publisher has enqueued it. A partial index on the unpublished
  // rows lives in the migration - the table grows forever, the backlog does not.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@map("outbox_events")
}

// The worker idempotency ledger. In Postgres rather than Redis so it survives a
// cache flush - durability is the entire point (ADR-008).
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  // One event legitimately feeds several processors; each records its own row.
  processor   String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, processor])
  @@map("processed_events")
}
