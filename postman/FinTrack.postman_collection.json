{
  "info": {
    "_postman_id": "3b5be39c-b012-45c3-b4e9-4b1b451c5efd",
    "name": "FinTrack API",
    "description": "FinTrack \u2014 transaction analytics and reporting platform.\n\nRun the folders top to bottom: Auth captures the JWT into {{token}}, Accounts captures {{accountId}}, and everything after that uses them. No manual copying.\n\nBase URL defaults to http://localhost:8080 (through Nginx). Use http://localhost:4000 to hit a single API instance directly.\n\nNote the async boundary: after posting a transaction, analytics and activity are updated by a worker a moment later. A report that has never been generated answers 202, not 404 \u2014 ask again shortly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates the user and returns a JWT. The email is generated per run by a pre-request script so the request stays repeatable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"Demo User\",\n  \"password\": \"correct-horse-battery\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh address each run, so re-running does not collide with the last one.",
                  "pm.collectionVariables.set('email', `demo-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Same response shape as register. Note that a wrong password and an unknown email return an identical 401 \u2014 that is deliberate, so the endpoint cannot be used to discover which addresses are registered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"correct-horse-battery\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Identity comes from the token only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Accounts",
      "item": [
        {
          "name": "Create account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountType\": \"BROKERAGE\",\n  \"currency\": \"INR\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('accountId', pm.response.json().account.id);",
                  "pm.test('balance is a string, never a JSON number', () =>",
                  "  pm.expect(pm.response.json().account.balance).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts?limit=20&cursor=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Keyset-paginated. Pass pageInfo.nextCursor as `cursor` for the next page."
          }
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            },
            "description": "Another user's account returns 404, identical to one that does not exist."
          }
        }
      ]
    },
    {
      "name": "3. Transactions",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Runs as one database transaction: row lock, insert, balance update and outbox write all commit together.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": \"100000.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transactionId', pm.response.json().transaction.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "The amount is computed server-side as quantity x price; a client-supplied amount is rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BUY\",\n  \"accountId\": \"{{accountId}}\",\n  \"symbol\": \"INFY\",\n  \"quantity\": \"10\",\n  \"price\": \"100.00\"\n}"
            }
          }
        },
        {
          "name": "Sell",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Rejected with 422 if it would exceed the holding \u2014 no short selling.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SELL\",\n  \"accountId\": \"{{accountId}}\",\n  \"symbol\": \"INFY\",\n  \"quantity\": \"5\",\n  \"price\": \"150.00\"\n}"
            }
          }
        },
        {
          "name": "Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Rejected with 422 if it would overdraw.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"WITHDRAWAL\",\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": \"1000.00\"\n}"
            }
          }
        },
        {
          "name": "Deposit (idempotent retry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "demo-key-001"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "description": "Send this TWICE with the same Idempotency-Key. The second call returns 200 with the original transaction and creates nothing \u2014 not 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DEPOSIT\",\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": \"500.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 first time, 200 on replay', () =>",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions?limit=20&type=BUY&symbol=INFY&from=2026-01-01&to=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "BUY",
                  "disabled": true
                },
                {
                  "key": "symbol",
                  "value": "INFY",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "{{transactionId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Plans & subscriptions",
      "item": [
        {
          "name": "Create plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monthly SIP\",\n  \"planType\": \"SIP\",\n  \"amount\": \"5000.00\",\n  \"frequency\": \"MONTHLY\",\n  \"startDate\": \"2026-01-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('planId', pm.response.json().plan.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List plans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans?status=ACTIVE&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Update plan",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans",
                "{{planId}}"
              ]
            },
            "description": "An empty body is a 422 rather than a silent no-op.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAUSED\"\n}"
            }
          }
        },
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions"
              ]
            },
            "description": "A second active subscription to the same plan returns 409, enforced by a partial unique index rather than a check-then-insert.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('subscriptionId', pm.response.json().subscription.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/subscriptions?status=ACTIVE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Cancel subscription",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/subscriptions/{{subscriptionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions",
                "{{subscriptionId}}"
              ]
            },
            "description": "Cancelling twice returns 404 \u2014 the second call changes nothing and emits no event."
          }
        }
      ]
    },
    {
      "name": "5. Analytics & activity",
      "item": [
        {
          "name": "Portfolio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "portfolio"
              ]
            },
            "description": "Run this TWICE and compare the x-cache response header: MISS then HIT. marketValue and unrealizedPnl are null on purpose \u2014 there is no price feed, and a number derived from cost basis would look like a valuation without being one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "console.log('x-cache:', pm.response.headers.get('x-cache'));"
                ]
              }
            }
          ]
        },
        {
          "name": "P&L",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/pnl",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "pnl"
              ]
            },
            "description": "Realised P&L using weighted-average cost basis; the method is stated in the response so a consumer never has to guess."
          }
        },
        {
          "name": "Activity analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/activity?from=2026-01-01&to=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "activity"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Activity history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/activity?limit=20&eventType=DEPOSIT_COMPLETED&from=2026-01-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activity"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "eventType",
                  "value": "DEPOSIT_COMPLETED",
                  "disabled": true
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "disabled": true
                }
              ]
            },
            "description": "Served from MongoDB. Written by the worker a moment after the transaction, so a request immediately after a POST may not include it yet."
          }
        }
      ]
    },
    {
      "name": "6. Reports",
      "item": [
        {
          "name": "Daily report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/daily?date=2026-09-19",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "daily"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-09-19",
                  "disabled": true
                }
              ]
            },
            "description": "202 with Retry-After if the snapshot has not been generated yet \u2014 the request also queues the generation. Ask again in a few seconds for 200."
          }
        },
        {
          "name": "Monthly report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/monthly?month=2026-09",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "monthly"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-09",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Probes Postgres, MongoDB and Redis independently. Postgres down returns 503; Redis or MongoDB down returns 200 with that subsystem marked down, because they degrade rather than fail. x-instance-id shows which API instance answered."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => pm.response.to.have.status(200));",
                  "console.log('served by:', pm.response.headers.get('x-instance-id'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}